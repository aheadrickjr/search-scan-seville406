# Copy this file to ".env" and fill in your real values.
# ".env" is git-ignored -- never commit real API keys.

# Brave Search API key. Get one at https://api.search.brave.com/app/keys
# (see README "Setup > Brave Search API key" for the full sign-up walkthrough).
BRAVE_API_KEY=

# SQLite database file (created automatically on first run).
DATABASE_PATH=data/scans.db

# Contact info embedded in the User-Agent header sent to third-party sites
# during link validation, so site owners can identify/contact the operator
# of this tool if needed. Use an email you control.
CONTACT_EMAIL=you@example.com

# Seconds to wait between requests to the *same* domain during link
# validation (politeness / rate limiting).
LINK_VALIDATOR_RATE_LIMIT_SECONDS=1.0

# HTTP request timeout (seconds) for link validation checks.
LINK_VALIDATOR_TIMEOUT_SECONDS=15

# Number of organic results to request per query from the search provider.
SEARCH_RESULTS_PER_QUERY=20

# Timeout (seconds) for the headless-browser page load used for link
# validation and screenshots (Phase 2). JS-heavy OTA pages can take longer
# than a plain HTTP request to finish loading.
BROWSER_TIMEOUT_SECONDS=20
